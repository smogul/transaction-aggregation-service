{
  // Settings shared by every environment.
  // appsettings.{Environment}.json is read on top of this file and only lists what is different.
  // Example: appsettings.Development.json sets "Fapi": { "Enabled": false }, which replaces the true below.

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Our GlobalExceptionHandler already logs real crashes. Without this line .NET would also log
      // every normal "404 Not Found" and "400 Bad request" as a failure.
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",

  // All the mock data lives in the SeedData folder of the infra project, and is copied next to the app.
  "DataSources": {
    // The Excel data source.
    "ExcelFilePath": "SeedData/transactions.xlsx",

    // The API data source: a pretend "other bank". No real server lives at this address.
    // MockBankApiHandler answers instead, using the rows in MockBankFilePath.
    "MockBankApiUrl": "https://mock-bank.local/",
    "MockBankFilePath": "SeedData/mock-bank-transactions.json"
  },

  "Statements": {
    // A download link stops working after this many minutes.
    "LinkLifetimeMinutes": 15,

    // The biggest statement file a customer may upload, in MB.
    "MaxUploadSizeMegabytes": 10
  },

  "Fapi": {
    // FAPI security is ON unless an environment file switches it off. Only Development does that.
    "Enabled": true,

    // Who makes the tokens, and who they are for. A token with any other values is refused.
    "Issuer": "transaction-aggregation-api",
    "Audience": "transaction-aggregation-api",

    // The app allowed to ask for tokens. Swagger fills in the ClientId for you.
    // Each environment file sets its own ClientSecret.
    "ClientId": "swagger-client",

    // A token works for 10 minutes, then you ask for a new one.
    "TokenLifetimeMinutes": 10
  }
}
