{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",

  "DataSources": {
    "ExcelFilePath": "SeedData/transactions.xlsx",
    "MockBankApiUrl": "https://mock-bank.local/",
    "MockBankFilePath": "SeedData/mock-bank-transactions.json"
  },

  "Statements": {
    "LinkLifetimeMinutes": 15,
    "MaxUploadSizeMegabytes": 10
  },

  "Fapi": {
    "Enabled": true,
    "Audience": "transaction-aggregation-api",
    "ClientId": "swagger-client"
  }
}
