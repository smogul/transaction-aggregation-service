{
  // Development: your own computer. No login needed, so you can try everything in Swagger straight away.

  "ConnectionStrings": {
    // The database lives in memory, so no .db file is made and every run starts fresh from the seed data.
    // To keep the data in a file instead, use: "Data Source=transactions-dev.db"
    "Database": "Data Source=TransactionsDev;Mode=Memory;Cache=Shared"
  },

  "Fapi": {
    "Enabled": false
  }
}
