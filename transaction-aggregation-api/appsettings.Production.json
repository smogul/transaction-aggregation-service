{
  // Production: the real thing. FAPI security is ON, so every request needs an access token.

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    // In memory for now. Point this at the production database server when there is one.
    "Database": "Data Source=Transactions;Mode=Memory;Cache=Shared"
  },

  "Fapi": {
    // A real bank never keeps a secret in this file. It would come from an
    // environment variable (Fapi__ClientSecret) or a key vault instead.
    "ClientSecret": "change-me-in-production"
  }
}
